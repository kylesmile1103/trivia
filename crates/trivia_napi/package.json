{
  "name": "@trivia/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node.js binding for the Trivia OXC engine",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["index.js", "index.d.ts", "*.node"],
  "napi": {
    "binaryName": "trivia-engine"
  },
  "scripts": {
    "build": "napi build --platform --release --esm",
    "build:debug": "napi build --platform --esm",
    "test": "cargo test -p trivia_napi && node test/deep-nesting.mjs",
    "lint": "cargo clippy -p trivia_napi --all-targets -- -D warnings"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.8"
  },
  "nx": {
    "name": "engine",
    "implicitDependencies": ["oxc-engine"],
    "targets": {
      "build": {
        "inputs": ["production", "^production", "rust"],
        "outputs": ["{projectRoot}/*.node", "{projectRoot}/index.js", "{projectRoot}/index.d.ts"]
      },
      "test": { "dependsOn": ["build"], "inputs": ["default", "^production", "rust"] },
      "lint": { "inputs": ["default", "^production", "rust"] }
    }
  }
}
