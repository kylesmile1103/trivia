{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trivia",
  "version": "0.2.0",
  "identifier": "dev.trivia.shell",
  "build": { "frontendDist": "waiting" },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "A native window on the Trivia designer",
    "license": "MIT",
    "macOS": { "signingIdentity": "-" }
  }
}
