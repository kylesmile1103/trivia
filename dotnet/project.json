{
  "name": "dotnet",
  "namedInputs": {
    "dotnet": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/packages/blueprint/schemas/app.v1.json",
      "{workspaceRoot}/packages/blueprint/schemas/model.v1.json"
    ]
  },
  "targets": {
    "build": {
      "command": "dotnet build dotnet/Trivia.Blueprint.slnx",
      "inputs": ["dotnet"],
      "outputs": [],
      "cache": true
    },
    "test": {
      "command": "dotnet test dotnet/Trivia.Blueprint.slnx",
      "dependsOn": ["build"],
      "inputs": ["dotnet", "{workspaceRoot}/packages/blueprint/fixtures/model/**/*"],
      "cache": true,
      "parallelism": false
    },
    "tool": {
      "command": "dotnet publish dotnet/src/Trivia.Blueprint.Codegen/Trivia.Blueprint.Codegen.csproj -c Release -o dist/trivia-dotnet --nologo",
      "inputs": ["dotnet"],
      "outputs": ["{workspaceRoot}/dist/trivia-dotnet"],
      "cache": true
    }
  }
}
