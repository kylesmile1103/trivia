<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackAsTool>true</PackAsTool>
    <PackageId>Trivia.Blueprint.Codegen</PackageId>
    <ToolCommandName>trivia-dotnet</ToolCommandName>
    <Version>0.3.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../packages/blueprint/schemas/app.v1.json" LogicalName="Schemas/app.v1.json" />
    <EmbeddedResource Include="../../../packages/blueprint/schemas/model.v1.json" LogicalName="Schemas/model.v1.json" />
    <EmbeddedResource Include="../../Directory.Packages.props" LogicalName="PackageVersions" />
    <EmbeddedResource Include="Scaffold/**/*.txt" WithCulture="false" LogicalName="Scaffold/%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>
</Project>
