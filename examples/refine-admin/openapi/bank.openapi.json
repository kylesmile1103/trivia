{
  "openapi": "3.1.0",
  "info": {
    "title": "Bank back-office API",
    "version": "1.0.0",
    "description": "In-memory mock for the refine-admin example (mock-api.ts)."
  },
  "tags": [
    {
      "name": "Customers"
    },
    {
      "name": "Accounts"
    },
    {
