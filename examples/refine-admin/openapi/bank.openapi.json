  "components": {
    "schemas": {
      "CustomerStatus": {
        "type": "string",
        "enum": [
          "pending",
          "active",
          "suspended"
        ]
      },
      "KycStatus": {
        "type": "string",
        "enum": [
          "not_started",
          "in_review",
          "approved",
          "rejected"
        ]
      },
      "Segment": {
        "type": "string",
        "enum": [
          "retail",
          "private",
          "business"
        ]
      },
      "AccountType": {
        "type": "string",
        "enum": [
          "checking",
          "savings",
          "credit"
        ]
      },
      "AccountStatus": {
        "type": "string",
        "enum": [
          "open",
          "frozen",
          "closed"
        ]
      },
      "Currency": {
        "type": "string",
        "enum": [
          "EUR",
          "USD",
          "GBP"
        ]
      },
      "Direction": {
        "type": "string",
        "enum": [
          "credit",
          "debit"
        ]
      },
      "TransactionStatus": {
        "type": "string",
        "enum": [
          "pending",
          "booked",
          "reversed"
        ]
      },
      "CustomerDto": {
        "type": "object",
        "required": [
          "id",
          "fullName",
          "email",
          "status",
          "kycStatus",
          "segment",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "fullName": {
            "type": "string",
            "minLength": 2
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/CustomerStatus"
          },
          "kycStatus": {
            "$ref": "#/components/schemas/KycStatus"
          },
          "segment": {
            "$ref": "#/components/schemas/Segment"
          },
          "creditLimit": {
            "type": "number",
            "minimum": 0
          },
          "birthDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        }
      },
      "CreateCustomerRequest": {
        "type": "object",
        "required": [
          "fullName",
          "email",
          "segment"
        ],
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 2
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "segment": {
            "$ref": "#/components/schemas/Segment"
          },
          "creditLimit": {
            "type": "number",
            "minimum": 0
          },
          "birthDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        }
      },
      "UpdateCustomerRequest": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 2
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/CustomerStatus"
          },
          "segment": {
            "$ref": "#/components/schemas/Segment"
          },
          "creditLimit": {
            "type": "number",
            "minimum": 0
          },
          "birthDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        }
      },
      "CustomerPage": {
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomerDto"
            }
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "AccountDto": {
        "type": "object",
        "required": [
          "id",
          "customerId",
          "iban",
          "type",
          "currency",
          "balance",
          "status",
          "openedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "iban": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/AccountType"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "balance": {
            "type": "number"
          },
          "overdraftLimit": {
            "type": "number",
            "minimum": 0
          },
          "status": {
            "$ref": "#/components/schemas/AccountStatus"
          },
          "openedAt": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "CreateAccountRequest": {
        "type": "object",
        "required": [
          "customerId",
          "type",
          "currency"
        ],
        "properties": {
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "$ref": "#/components/schemas/AccountType"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "overdraftLimit": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "UpdateAccountRequest": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/AccountStatus"
          },
          "overdraftLimit": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "AccountPage": {
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountDto"
            }
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "TransactionDto": {
        "type": "object",
        "required": [
          "id",
          "accountId",
          "amount",
          "currency",
          "direction",
          "status",
          "bookedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "direction": {
            "$ref": "#/components/schemas/Direction"
          },
          "status": {
            "$ref": "#/components/schemas/TransactionStatus"
          },
          "counterparty": {
            "type": "string"
          },
          "reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "bookedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TransactionPage": {
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionDto"
            }
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
