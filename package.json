{
  "name": "trivia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build:engine": "pnpm --filter @trivia/engine build",
    "build:plugin": "pnpm --filter @trivia/vite-plugin-ast-locator build",
    "dev:playground": "pnpm build:engine && pnpm build:plugin && pnpm --filter playground dev",
    "dev:designer": "pnpm --filter @trivia/designer dev",
    "test": "cargo test --workspace && pnpm build:engine && pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@playwright/test": "1.63.0"
  }
}
