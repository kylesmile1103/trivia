{
  "string": {
    "csharp": "string",
    "postgres": "varchar({maxLength})",
    "postgresWithoutMaxLength": "text",
    "openapi": {
      "type": "string"
    },
    "zod": "z.string()"
  },
  "text": {
    "csharp": "string",
    "postgres": "text",
    "openapi": {
      "type": "string"
    },
    "zod": "z.string()"
  },
  "int": {
    "csharp": "int",
    "postgres": "integer",
    "openapi": {
      "type": "integer",
      "format": "int32"
    },
    "zod": "z.number().int()"
  },
  "long": {
    "csharp": "long",
    "postgres": "bigint",
    "openapi": {
      "type": "integer",
      "format": "int64"
    },
    "zod": "z.number().int()"
  },
  "decimal": {
    "csharp": "decimal",
    "postgres": "numeric({precision},{scale})",
    "openapi": {
      "type": "number"
    },
    "zod": "z.number()"
  },
  "bool": {
    "csharp": "bool",
    "postgres": "boolean",
    "openapi": {
      "type": "boolean"
    },
    "zod": "z.boolean()"
  },
  "date": {
    "csharp": "DateOnly",
    "postgres": "date",
    "openapi": {
      "type": "string",
      "format": "date"
    },
    "zod": "z.string()"
  },
  "datetime": {
    "csharp": "DateTimeOffset",
    "postgres": "timestamptz",
    "openapi": {
      "type": "string",
      "format": "date-time"
    },
    "zod": "z.string()"
  },
  "uuid": {
    "csharp": "Guid",
    "postgres": "uuid",
    "openapi": {
      "type": "string",
      "format": "uuid"
    },
    "zod": "z.string().uuid()"
  },
  "enum": {
    "csharp": "{enum}",
    "postgres": "text CHECK ({column} IN ({values}))",
    "openapi": {
      "$ref": "#/components/schemas/{enum}"
    },
    "zod": "z.enum([{values}])"
  },
  "json": {
