{
  "name": "@trivia/blueprint",
  "version": "0.2.0",
  "private": true,
  "description": "Blueprint documents for Trivia: zod types, canonical serialization, guarded BlueprintOps, layered validation, migrations, a store that computes file writes, and a read-only projection",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/emit-schemas.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@trivia/engine": "workspace:*",
    "@types/node": "^24.13.3",
    "ajv": "^8.20.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  },
  "nx": {
    "name": "blueprint",
    "targets": {
      "build": {
        "outputs": ["{projectRoot}/dist", "{projectRoot}/schemas"]
      }
    }
  }
}
