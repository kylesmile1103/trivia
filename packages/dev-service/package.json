{
  "name": "@trivia/dev-service",
  "version": "0.2.0",
  "private": true,
  "description": "The shared Trivia engine API, edit service, and MCP endpoint",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@trivia/contract-sync": "workspace:*",
    "@trivia/engine": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  },
  "nx": {
    "name": "dev-service"
  }
}
