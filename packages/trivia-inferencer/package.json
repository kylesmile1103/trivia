{
  "name": "@trivia/openapi-inferencer",
  "version": "0.1.0",
  "private": true,
  "description": "A drop-in, contract-driven replacement for Refine's inferencer: pages from the OpenAPI contract, previewed live and ejected to disk by Trivia's dev server",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@refinedev/core": ">=5.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@refinedev/core": "5.0.12",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^30.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
}
